data Etapa = NaFila | NoBanho | Concluido
  deriving (Show, Eq)

data Atendimento = Atendimento
  { cliente :: String
  , servico :: String
  , valor :: Double
  , etapa :: Etapa
  }

descrever :: Atendimento -> String
descrever atendimento =
  cliente atendimento ++ " - "
    ++ servico atendimento ++ " - "
    ++ show (etapa atendimento)
    ++ " - R$ " ++ show (valor atendimento)

concluir :: Atendimento -> Atendimento
concluir atendimento = atendimento { etapa = Concluido }

arrecadado :: [Atendimento] -> Double
arrecadado atendimentos =
  sum (map valor (filter (\atendimento -> etapa atendimento == Concluido) atendimentos))

main :: IO ()
main = do
  let atendimento1 =
        Atendimento "Haku" "Banho termal" 30.0 NaFila
  let atendimento2 =
        Atendimento "Sem Rosto" "Banho especial" 50.0 NoBanho
  let atendimento3 =
        Atendimento "Deus do rio" "Limpeza" 80.0 NaFila

  let atendimentos = [atendimento1, atendimento2, atendimento3]

  let atendimentosAtualizados =
        [ concluir atendimento1
        , atendimento2
        , concluir atendimento3
        ]

  putStrLn "--- Atendimentos originais ---"
  mapM_ putStrLn (map descrever atendimentos)
  putStrLn ("Arrecadado: R$ " ++ show (arrecadado atendimentos))

  putStrLn "--- Atendimentos atualizados ---"
  mapM_ putStrLn (map descrever atendimentosAtualizados)
  putStrLn ("Arrecadado: R$ " ++ show (arrecadado atendimentosAtualizados))
