class Instrumentista
  attr_reader :nome, :instrumento

  def initialize(nome, instrumento)
    @nome = nome
    @instrumento = instrumento
  end

  def interpretar(peca)
    raise NotImplementedError, "Método interpretar não implementado"
  end
end

class Solista < Instrumentista
  def interpretar(peca)
    puts "#{nome} toca #{instrumento} e conduz a melodia principal de #{peca}."
  end
end

class Acompanhador < Instrumentista
  def interpretar(peca)
    puts "#{nome} toca #{instrumento} e acompanha o ritmo do solista em #{peca}."
  end
end

class Regente
  def initialize(nome)
    @nome = nome
    @orquestra = []
  end

  def convocar(instrumentista)
    @orquestra << instrumentista
  end

  def reger(peca)
    puts "#{@nome} rege a peça #{peca}."

    @orquestra.each do |instrumentista|
      instrumentista.interpretar(peca)
    end
  end

  def escalacao
    @orquestra.map do |instrumentista|
      "#{instrumentista.class} - #{instrumentista.nome}"
    end
  end
end

solista = Solista.new("Kaori", "Piano")
acompanhador = Acompanhador.new("Takeshi", "Violino")
regente = Regente.new("Carlos")

regente.convocar(solista)
regente.convocar(acompanhador)

regente.reger("Concerto de Primavera")

puts "\nEscalação:"

regente.escalacao.each do |instrumentista|
  puts instrumentista
end

